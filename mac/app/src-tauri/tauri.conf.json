{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperBookScanner",
  "version": "0.1.0",
  "identifier": "io.github.k-ohki.superbookscanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SuperBookScanner",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../../models/uvdoc.onnx": "models/uvdoc.onnx"
    }
  }
}
